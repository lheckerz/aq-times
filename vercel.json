{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/shell",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/seo?page=home"
    },
    {
      "source": "/news",
      "destination": "/api/seo?page=news"
    },
    {
      "source": "/news/:sport",
      "destination": "/api/seo?page=news&sport=:sport"
    },
    {
      "source": "/updates",
      "destination": "/api/seo?page=updates"
    },
    {
      "source": "/updates/:slug",
      "destination": "/api/seo?page=update&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?page=sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/seo?page=feed"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo?page=llms"
    },
    {
      "source": "/share.png",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*WhatsApp.*"
        }
      ],
      "destination": "/share-square.png"
    },
    {
      "source": "/share.png",
      "destination": "/share-wide.png"
    }
  ],
  "functions": {
    "api/seo.js": {
      "includeFiles": "shell.html",
      "maxDuration": 15
    }
  }
}