{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share.png",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*WhatsApp.*"
        }
      ],
      "destination": "/share-square.png"
    },
    {
      "source": "/share.png",
      "destination": "/share-wide.png"
    }
  ]
}